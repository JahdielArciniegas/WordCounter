---
import Layout from '../layouts/Layout.astro';
import { ActiveWordsManager } from '../components/ActiveWordsManager';
import { activeVocabService } from '../services/active.service';

export const prerender = false;

const stats = activeVocabService.getStats('es');
---

<Layout title="Vocabulario Activo — WordCounter">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-zinc-800/60 pb-5">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Producción Léxica</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-100">
          Vocabulario Activo
        </h1>
        <p class="text-zinc-400 text-xs sm:text-sm mt-1">
          Palabras que utilizás en tus redacciones. La frecuencia se acumula automáticamente en cada análisis.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <div class="bg-zinc-900/80 border border-zinc-800 px-3 py-1.5 rounded-lg text-xs font-mono text-zinc-300">
          <span class="text-zinc-500">Únicas:</span> <strong class="text-emerald-400 font-semibold">{stats.activeCount}</strong>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 px-3 py-1.5 rounded-lg text-xs font-mono text-zinc-300">
          <span class="text-zinc-500">Ocurrencias:</span> <strong class="text-indigo-400 font-semibold">{stats.totalActiveOccurrences}</strong>
        </div>
      </div>
    </div>

    <!-- Client Interactive Island -->
    <ActiveWordsManager client:load />
  </div>
</Layout>
